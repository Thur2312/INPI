# Credenciais do INPI (nunca commitar o .env real)
INPI_USUARIO=
INPI_SENHA=

# Caminho do banco SQLite
DB_PATH=./data/inpi.db

# Parametros da operacao
MAX_WORKERS=4
# false = abre uma janela do Chrome visivel por worker (cada um com sua
# propria sessao/aba), util pra acompanhar ao vivo localmente. Manter
# "true" na VPS -- sem display configurado (Xvfb), rodar headed la derruba
# o processo.
HEADLESS=true
HORA_ABERTURA_COTA=10:00
HORA_LIMITE_EMISSAO=22:00
HARD_STOP_22H=false
MAX_TENTATIVAS=3
ORFAO_TIMEOUT_MINUTOS=15
BACKUP_INTERVALO_MINUTOS=5

# Ritmo da operacao (defaults = comportamento ja testado localmente).
# Reduzir as pausas/largada e subir MAX_WORKERS aumenta o throughput mas
# tambem o risco de o INPI identificar o trafego como automacao e
# bloquear a conta/IP -- decisao para tomar no dia, com cautela crescente
# (ex.: comecar com um valor intermediario e so escalar se nao houver
# ERRO_CAPTCHA/bloqueio nos primeiros minutos). Ver docs/runbook-vps.md.
# MAX_WORKERS pode ir ate 20.
PAUSA_ENTRE_ACOES_MIN_MS=2000
PAUSA_ENTRE_ACOES_MAX_MS=4000
LARGADA_WORKER_MIN_MS=10000
LARGADA_WORKER_MAX_MS=15000
VERIFICADOR_INTERVALO_MIN_MS=20000
VERIFICADOR_INTERVALO_MAX_MS=30000
ESPERA_FILA_VAZIA_MS=3000

# Diretorio de saida (guias, erros, logs, relatorios)
OUTPUT_DIR=./output
DASHBOARD_PORT=3000
# Senha do painel (HTTP Basic Auth, usuario e ignorado). Sem isso o painel
# fica sem autenticacao propria -- so aceitavel atras de rede fechada
# (Tailscale). Obrigatorio na pratica agora que o painel recebe planilha
# com CPF/CNPJ e pode iniciar a automacao de verdade. Minimo 8 caracteres.
DASHBOARD_SENHA=

# Portal do cliente (src/portalCliente) — separado do painel interno acima.
# Cliente loga só com CNPJ/CPF e ve/baixa apenas os proprios boletos GRU;
# admin ve tudo via Basic Auth em /api/admin/*.
PORTAL_CLIENTE_PORT=3001
# Obrigatorio pra subir o portal do cliente — assina a sessao de login por
# CNPJ/CPF. Gere um valor aleatorio de pelo menos 32 caracteres, ex.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_CLIENTE_TOKEN_SEGREDO=
PORTAL_CLIENTE_ADMIN_SENHA=

NODE_ENV=development
