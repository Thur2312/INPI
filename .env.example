# Credenciais do INPI (nunca commitar o .env real)
INPI_USUARIO=
INPI_SENHA=

# Caminho do banco SQLite
DB_PATH=./data/inpi.db

# Parametros da operacao
MAX_WORKERS=4
VALOR_ESPERADO_GRU=445.00
HORA_ABERTURA_COTA=10:00
HORA_LIMITE_EMISSAO=22:00
HARD_STOP_22H=false
MAX_TENTATIVAS=3
ORFAO_TIMEOUT_MINUTOS=15
BACKUP_INTERVALO_MINUTOS=5

# Diretorio de saida (guias, erros, logs, relatorios)
OUTPUT_DIR=./output

NODE_ENV=development
